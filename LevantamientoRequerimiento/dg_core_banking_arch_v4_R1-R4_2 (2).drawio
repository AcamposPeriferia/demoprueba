          <mxGeometry height="150" width="380" x="40" y="770" as="geometry" />
        </mxCell>
        <mxCell id="p01-source" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Nota de lectura&lt;/b&gt;&lt;br&gt;R1E = capacidad activa solo en modo evento/sincronizacion minima durante R1 (no administracion plena).&lt;br&gt;La administracion plena de cartera y riesgo se alcanza progresivamente en R3 (migracion de stock) y R4 (nueva metodologia, No Gas).&lt;br&gt;Fuente: Evaluacion_Arquitectura_CoreBanking_R1-R4.md, seccion 2 (Capacidades de Negocio BIAN)." vertex="1">
