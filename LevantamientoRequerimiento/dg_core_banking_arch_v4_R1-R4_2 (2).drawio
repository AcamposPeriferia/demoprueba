          <mxGeometry height="150" width="380" x="950" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p05-risk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#DA532C;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Camino critico del programa:&lt;/b&gt;&lt;br&gt;FICA vs SD, rol de Ayesa/NTT y uso de BPA aun sin cerrar con SAP.&lt;br&gt;Bloquea toda interfaz Core-SAP en las 4 releases, no solo R1.&lt;br&gt;&lt;b&gt;Cierre obligado&lt;/b&gt; antes de iniciar especificacion tecnica de cualquier interfaz." vertex="1">
          <mxGeometry height="150" width="500" x="140" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p05-risk2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#DA532C;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Riesgo de convivencia (R1, critico en R3-R4):&lt;/b&gt;&lt;br&gt;La cartera del Core debe convivir con la de SAP en Cerebro de Cartera (marcas, prelacion, conciliacion).&lt;br&gt;Subestimarlo arrastra la migracion de stock (R3) y el control de edad de cartera No Gas (R4)." vertex="1">
          <mxGeometry height="150" width="470" x="700" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p05-r2r3-title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=13;fontColor=#333333;fontStyle=1;" value="Integraciones especificas de R2 y R3" vertex="1">
          <mxGeometry height="26" width="900" x="140" y="720" as="geometry" />
        </mxCell>
        <mxCell id="p05-r2a" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#B8860B;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;Financiaciones RPO en SAP (hoy)&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#B8860B;margin-top:2px;&quot;&gt;R2 · Q1-2027&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;fuente a migrar&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="240" x="140" y="760" as="geometry" />
        </mxCell>
        <mxCell id="p05-r2b" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#B8860B;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;Motor de originacion generico&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#B8860B;margin-top:2px;&quot;&gt;R2 · Q1-2027&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;nuevo tipo de producto en Core&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="240" x="430" y="760" as="geometry" />
        </mxCell>
        <mxCell id="p05-r2-a1" edge="1" parent="1" source="p05-r2a" target="p05-r2b" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#B8860B;" value="cese progresivo">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-r3a" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#1565C0;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;Stock de creditos activos (SAP)&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#1565C0;margin-top:2px;&quot;&gt;R3 · Q2-2027&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;carga historica&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="240" x="780" y="760" as="geometry" />
        </mxCell>
        <mxCell id="p05-r3b" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#1565C0;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;ETL de migracion + conciliacion&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#1565C0;margin-top:2px;&quot;&gt;R3 · Q2-2027&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;criterios de aceptacion por definir&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="240" x="1070" y="760" as="geometry" />
        </mxCell>
        <mxCell id="p05-r3-a1" edge="1" parent="1" source="p05-r3a" target="p05-r3b" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#1565C0;" value="migracion por oleadas">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=11.5;" value="&lt;b&gt;Convencion de Releases (programa R1-R4)&lt;/b&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;span style=&quot;color:#2E7D32;font-weight:bold;&quot;&gt;■ R1 · Q4-2026&lt;/span&gt; - Core Banking clientes Gas, minimo impacto a SAP&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#B8860B;font-weight:bold;&quot;&gt;■ R2 · Q1-2027&lt;/span&gt; - Migracion de producto RPO (SAP -&gt; Core)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#1565C0;font-weight:bold;&quot;&gt;■ R3 · Q2-2027&lt;/span&gt; - Migracion de stock de creditos activos&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#DA532C;font-weight:bold;&quot;&gt;■ R4 · Q3-2027&lt;/span&gt; - Financiacion No Gas + nueva metodologia de riesgo&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#5E35B1;font-weight:bold;&quot;&gt;■ Transversal&lt;/span&gt; - Habilitador construido una vez, reutilizado en R1-R4&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="380" x="40" y="900" as="geometry" />
        </mxCell>
        <mxCell id="p05-flujo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Principio transversal:&lt;/b&gt; SAP estandar y acotado en las 4 releases - se usa como canal de facturacion/recaudo (SD/IS-U/FI-CA) y como fuente de migracion (R2, R3), sin replicar en ningun momento la logica funcional del credito.&lt;br&gt;Fuente: Evaluacion_Arquitectura_CoreBanking_R1-R4.md, secciones 3, 6 y 7." vertex="1">
          <mxGeometry height="150" width="1130" x="460" y="900" as="geometry" />
        </mxCell>
