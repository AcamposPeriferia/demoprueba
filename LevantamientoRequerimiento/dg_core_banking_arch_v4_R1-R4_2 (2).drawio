        <mxCell id="p02-note" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECE7;strokeColor=#DA532C;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Hallazgo de auditoria:&lt;/b&gt; el Modulo de Liquidaciones de R1 corresponde al riesgo &quot;liquidacion de aliados&quot; identificado previamente como frente nuevo y no cotizado. Formalizar cobertura contractual con Sofka antes de construir." vertex="1">
