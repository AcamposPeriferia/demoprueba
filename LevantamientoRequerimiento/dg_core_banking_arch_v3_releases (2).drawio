        <mxCell id="p04-note1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Principio de minimo impacto (R1):&lt;/b&gt;&lt;br&gt;Facturacion, recaudo y contabilidad del cliente Gas se mantienen en SAP tal cual operan hoy.&lt;br&gt;Core Banking NO reemplaza el modulo de cartera de SAP en R1; solo gobierna la logica de originacion y ciclo de vida del credito.&lt;br&gt;Pendiente definir: criterios verificables de &#39;minimo impacto&#39; (que cambia y que no en el esquema SAP)." vertex="1">
          <mxGeometry height="160" width="380" x="1200" y="340" as="geometry" />
        </mxCell>
        <mxCell id="p04-note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#DA532C;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Riesgo (ver Infografia / Plan de Trabajo):&lt;/b&gt;&lt;br&gt;El ruteo de Vanti Listo (Gas -&gt; SAP, No Gas -&gt; Core) no debe romper la ruta SAP existente.&lt;br&gt;Requiere pruebas de regresion sobre SAP + pruebas E2E antes de Go-Live." vertex="1">
          <mxGeometry height="130" width="380" x="1200" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p04-legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;Convencion de Releases&lt;/b&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;span style=&quot;color:#2E7D32;font-weight:bold;&quot;&gt;■ R1 · 2026&lt;/span&gt; - Gas / Vanti Listo, minimo impacto a facturacion, cartera, recaudo y contabilidad&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#B8860B;font-weight:bold;&quot;&gt;■ R2&lt;/span&gt; - Ampliacion de alcance (post 2026)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#DA532C;font-weight:bold;&quot;&gt;■ R3&lt;/span&gt; - Clientes No Gas (fase final)&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="40" y="900" as="geometry" />
        </mxCell>
        <mxCell id="p04-notes" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;- El carril Gas es el flujo priorizado para 2026 (instruccion confirmada 24-ago-2026).&lt;br&gt;- El carril No Gas se muestra en gris/naranja punteado porque su diseno detallado (Portal de Pago, independencia de cobro) aun no esta construido.&lt;br&gt;- Fuente: Requerimiento v1.11 seccion 5.4 y notas de Discovery (Vanti Listo como enrutador de doble destino)." vertex="1">
          <mxGeometry height="90" width="1000" x="400" y="900" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="xdbRLxwCm2o_SooG80_C" name="05- Integración SAP y recaudo">
    <mxGraphModel dx="1406" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p05-title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;fontColor=#333333;fontStyle=1;" value="Integracion SAP y Recaudo - detalle tecnico (Requerimiento v1.11, seccion 5.3)" vertex="1">
          <mxGeometry height="30" width="1100" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="p05-subtitle" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=11;fontColor=#666666;" value="Interfaces criticas Core Banking &lt;-&gt; SAP para el release R1 (Gas / Vanti Listo, minimo impacto). SAP conserva facturacion, recaudo y contabilidad; Core Banking gobierna la logica del credito." vertex="1">
          <mxGeometry height="40" width="1150" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p05-core" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#2E7D32;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;Core Banking (Mambu)&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#2E7D32;margin-top:2px;&quot;&gt;R1 · 2026&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;maestro del credito&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="140" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-sap" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#2E7D32;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;SAP (SD / IS-U / FI / FI-CA)&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#2E7D32;margin-top:2px;&quot;&gt;R1 · 2026&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;factura gas, recaudo, contable&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="700" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-dl" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#2E7D32;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;Data Lake / Data Warehouse&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#2E7D32;margin-top:2px;&quot;&gt;R1 · 2026 (basico)&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;trazas para conciliacion (minimo en R1)&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="420" y="380" as="geometry" />
        </mxCell>
        <mxCell id="p05-cartera" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#B8860B;strokeWidth=2;dashed=1;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;Cerebro de Cartera (doble mundo)&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#B8860B;margin-top:2px;&quot;&gt;R2 · Ampliacion&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;convivencia Core vs SAP&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="700" y="480" as="geometry" />
        </mxCell>
        <mxCell id="p05-recaudo" parent="1" style="html=1;outlineConnect=0;whiteSpace=wrap;fillColor=#f5f5f5;shape=mxgraph.archimate4.element;appType=node;archiType=square;archiDomain=technology;fontColor=#333333;strokeColor=#2E7D32;strokeWidth=3;dashed=0;" value="&lt;&lt;Application Component&gt;&gt;&lt;div&gt;Canales de Recaudo (Gas)&lt;/div&gt;&lt;div style=&quot;font-size:9px;font-weight:bold;color:#2E7D32;margin-top:2px;&quot;&gt;R1 · 2026&lt;/div&gt;&lt;div style=&quot;font-size:8px;font-weight:normal;color:#666666;&quot;&gt;recaudadores actuales&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="140" y="380" as="geometry" />
        </mxCell>
        <mxCell id="p05-e1" edge="1" parent="1" source="p05-core" target="p05-sap" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#2E7D32;" value="Core -&gt; SAP: cargos periodicos (cuota, concepto, capital, interes, saldo, total cuotas)">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-e2" edge="1" parent="1" source="p05-sap" target="p05-core" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#2E7D32;" value="SAP -&gt; Core: respuesta procesamiento, errores, recaudos, compensaciones, estado de pago">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-e3" edge="1" parent="1" source="p05-core" target="p05-dl" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#2E7D32;" value="trazas de credito">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-e4" edge="1" parent="1" source="p05-sap" target="p05-dl" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#2E7D32;" value="trazas de factura y recaudo">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-e5" edge="1" parent="1" source="p05-recaudo" target="p05-sap" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#2E7D32;" value="recaudo factura gas">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-e6" edge="1" parent="1" source="p05-dl" target="p05-cartera" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#B8860B;dashed=1;" value="saldos, mora, score, historico">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-e7" edge="1" parent="1" source="p05-core" target="p05-cartera" style="edgeStyle=elbowEdgeStyle;html=1;endArrow=block;elbow=vertical;endFill=1;rounded=0;strokeColor=#B8860B;dashed=1;" value="alimenta segmentacion (R2)">
          <mxGeometry relative="1" width="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-mech1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Mecanismo sugerido (Core -&gt; SAP):&lt;/b&gt;&lt;br&gt;Archivo plano / API / middleware.&lt;br&gt;BPA SAP para carga de conceptos SD/IS-U cuando aplique.&lt;br&gt;&lt;b&gt;Control:&lt;/b&gt; identificadores unicos, acuses, control de duplicados, reprocesos, bitacora." vertex="1">
          <mxGeometry height="140" width="340" x="950" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p05-mech2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Mecanismo sugerido (SAP -&gt; Core):&lt;/b&gt;&lt;br&gt;Archivo de respuesta / API / evento.&lt;br&gt;Control de duplicados y reprocesos.&lt;br&gt;Traza para disminucion de cartera." vertex="1">
          <mxGeometry height="130" width="340" x="950" y="320" as="geometry" />
        </mxCell>
        <mxCell id="p05-risk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#DA532C;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;RIESGO ALTO ABIERTO (R2 en Infografia / Plan de Trabajo):&lt;/b&gt;&lt;br&gt;Definiciones SAP sin cerrar: &lt;b&gt;FICA vs SD&lt;/b&gt;, rol de Ayesa/NTT, uso de BPA.&lt;br&gt;Sin esta definicion firmada, el equipo Core&lt;-&gt;SAP no puede construir en firme.&lt;br&gt;&lt;b&gt;Cierre obligado:&lt;/b&gt; antes de iniciar especificaciones tecnicas de integracion (ruta critica R1)." vertex="1">
          <mxGeometry height="150" width="500" x="140" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p05-risk2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#DA532C;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;RIESGO ALTO (R3 / R3b en Infografia):&lt;/b&gt;&lt;br&gt;Convivencia Cerebro de Cartera (marcas, prelacion, conciliacion) y liquidacion de aliados (los creditos del Core no disparan pedido SAP SD; requiere liquidacion nueva Core -&gt; Data Lake).&lt;br&gt;Frente nuevo, no cotizado originalmente." vertex="1">
          <mxGeometry height="150" width="350" x="700" y="560" as="geometry" />
        </mxCell>
        <mxCell id="p05-flujo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontSize=10;" value="&lt;b&gt;Flujos tecnicos objetivo (Requerimiento v1.11, 5.4):&lt;/b&gt;&lt;br&gt;&lt;b&gt;Gas (R1):&lt;/b&gt; canal origina -&gt; Core crea/administra credito -&gt; Core envia cargos a SAP -&gt; SAP incorpora en factura -&gt; SAP informa recaudo/compensacion -&gt; Core actualiza saldo/cartera.&lt;br&gt;&lt;b&gt;No Gas (R3):&lt;/b&gt; canal origina obligacion -&gt; Core administra credito/estado de cuenta -&gt; recaudo por canal externo -&gt; contabilidad agregada a SAP cuando aplique.&lt;br&gt;&lt;b&gt;Minimo impacto R1:&lt;/b&gt; SAP estandar y acotado - se usa como canal de cobro en factura gas (SD/IS-U/FI-CA), sin replicar la logica de credito." vertex="1">
          <mxGeometry height="140" width="1150" x="140" y="750" as="geometry" />
        </mxCell>
        <mxCell id="p05-legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;Convencion de Releases&lt;/b&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;span style=&quot;color:#2E7D32;font-weight:bold;&quot;&gt;■ R1 · 2026&lt;/span&gt; - Gas / Vanti Listo, minimo impacto a facturacion, cartera, recaudo y contabilidad&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#B8860B;font-weight:bold;&quot;&gt;■ R2&lt;/span&gt; - Ampliacion de alcance (post 2026)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color:#DA532C;font-weight:bold;&quot;&gt;■ R3&lt;/span&gt; - Clientes No Gas (fase final)&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="330" x="40" y="920" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
