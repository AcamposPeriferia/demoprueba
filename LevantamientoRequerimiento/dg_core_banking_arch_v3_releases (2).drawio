        <mxCell id="brecha-eco-note" parent="brecha-ecosistema-01" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;fontColor=#666666;fontStyle=2" value="Requerimiento v1.11, proceso #12. Directorio Activo y Data Lake/DW se clasifican R1 porque son prerequisito de matriz de accesos, Go de Ciberseguridad y trazabilidad mínima (Requerimiento 5.2/5.3). El resto se confirma R2/R3 el 24-ago-2026 (Gas primero, mínimo impacto)." vertex="1">
          <mxGeometry height="90" width="290" x="19" y="714" as="geometry" />
        </mxCell>
        <mxCell id="release-legend-02" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" value="&lt;b&gt;Convención de Releases&lt;/b&gt;&lt;div style=&quot;margin-top:6px;&quot;&gt;&lt;span style=&quot;color: rgb(46, 125, 50); font-weight: bold;&quot;&gt;■ R1 · 2026&lt;/span&gt; — Gas / Vanti Listo, mínimo impacto a facturación, cartera, recaudo y contabilidad nuevos créditos.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(184, 134, 11); font-weight: bold;&quot;&gt;■ R2&lt;/span&gt; — Ampliación de alcance (post 2026)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(218, 83, 44); font-weight: 700; background-color: transparent;&quot;&gt;■&lt;/span&gt;&lt;span style=&quot;color: rgb(218, 83, 44); font-weight: 700; background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/span&gt;R3 - Migración&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(218, 83, 44); font-weight: bold;&quot;&gt;■ R4&lt;/span&gt; — Clientes No Gas (fase final)&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="340" x="2470" y="964" as="geometry" />
        </mxCell>
